<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Internet alleen voor de updatecontrole: het spel zelf zit volledig in de app
    en werkt zonder verbinding. Zonder netwerk mislukt de controle stil.
  -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Nodig om een gedownloade APK aan Android aan te bieden. Android vraagt de
       speler daarna zelf nog om toestemming voor installatie. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Trillen bij een versmelting of een prestatie (de speler kan het uitzetten). -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- De melding "je energie is weer vol". Op Android 13 en hoger vraagt de app
       de speler daar bij het starten om; zonder die toestemming blijft het spel
       gewoon werken, alleen zonder die ene melding. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application
      android:allowBackup="true"
      android:enableOnBackInvokedCallback="true"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:supportsRtl="false"
      android:theme="@style/SmakenlandTheme">
    <activity
        android:name=".MainActivity"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize"
        android:exported="true"
        android:label="@string/app_name"
        android:launchMode="singleTop"
        android:screenOrientation="portrait"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- De gedownloade APK gaat via deze provider naar de installateur; zonder
         provider weigert Android sinds versie 7 om een bestand te openen. -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.bestanden"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/bestanden" />
    </provider>

    <!-- De wekker die de melding plaatst als de energie vol is. -->
    <receiver
        android:name=".EnergieMelder"
        android:exported="false" />
  </application>
</manifest>
